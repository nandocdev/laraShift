{
    "mcpServers": {
        "dlocal-integration-mcp": {
            "url": "https://mcp.dlocal.com/integration",
            "transport": "http",
            "headers": {
                "x-merchant-id": "TU_MERCHANT_ID_AQUÍ"
            }
        },
        "codegraph": {
            "type": "stdio",
            "command": "codegraph",
            "args": [
                "serve",
                "--mcp"
            ]
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
    }
}