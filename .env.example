APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CENTRAL_DOMAIN=openSaaS.test
CENTRAL_DOMAINS=openSaaS.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
TENANCY_CACHE_BOOTSTRAPPER=false
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Provisioning (tenant lifecycle)
PROVISIONING_STALE_MINUTES=30

# Billing (gateway por defecto por tenant; ver docs/BILLING.md)
BILLING_GATEWAY_DEFAULT=clave

# Clave / PagueloFacil (sandbox por defecto; sin credenciales reales en CI)
CLAVE_MERCHANT_ID=
CLAVE_SECRET=
CLAVE_WEBHOOK_SECRET=
CLAVE_ENVIRONMENT=sandbox

# dLocal (sandbox por defecto; JS key separada para browser, nunca en CI)
DLOCAL_ENVIRONMENT=sandbox
DLOCAL_LOGIN=
DLOCAL_TRANS_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_WEBHOOK_SECRET=
DLOCAL_JS_API_KEY=
DLOCAL_COUNTRY_DEFAULT=PA

# Infrastructure / Railway
INFRASTRUCTURE_RAILWAY_API_TOKEN=
INFRASTRUCTURE_RAILWAY_PROJECT_ID=
INFRASTRUCTURE_RAILWAY_SERVICE_ID=
INFRASTRUCTURE_HEALTH_ALLOWED_IPS=

FRAUD_QUARANTINE_THRESHOLD=80
FRAUD_SECOPS_EMAIL=
FRAUD_DISPOSABLE_DOMAINS=
FRAUD_BLOCKED_IP_PREFIXES=
